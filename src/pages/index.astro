---
import Layout from '../layouts/Layout.astro';

/**
 * Portada NEUTRA a proposito.
 *
 * Si la persona que recibe el enlace recorta la URL y entra en la raiz,
 * no debe encontrar nada que le destripe la sorpresa. Toda la informacion
 * util para ti esta en /debug, que solo existe en desarrollo.
 */
---

<Layout title="—" description="">
  <div class="aurora"></div>
  <main class="screen">
    <p class="dot" aria-hidden="true">·</p>
    {import.meta.env.DEV && <a class="dev" href="/debug">panel local → /debug</a>}
  </main>
</Layout>

<style>
  .dot {
    margin: 0;
    font-size: 3rem;
    line-height: 1;
    color: rgba(244, 241, 234, 0.18);
  }

  .dev {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-bottom: 1px solid var(--ring);
    padding-bottom: 2px;
  }

  .dev:hover {
    color: var(--fg);
  }
</style>
