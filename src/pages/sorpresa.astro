---
import Layout from '../layouts/Layout.astro';
import { site, withBase } from '../config/site';

// Estos valores viajan al script del cliente (ver define:vars mas abajo).
// withBase() => en GitHub Pages redirige a /mi-repo/viewer, no a /viewer.
const destination = withBase(site.destination);
const delay = site.redirectDelayMs;
---

{/*
  IMPORTANTE: esta pagina NO redirige desde el servidor.
  El HTML se sirve completo con todas las etiquetas Open Graph para que
  el crawler de WhatsApp pueda leerlas. La redireccion a /viewer ocurre
  solo en el navegador, ~1 s despues, mediante JavaScript.
*/}
<Layout title="Tengo algo para ti 👀">
  <div class="aurora"></div>

  <main class="screen">
    <div class="gift rise" aria-hidden="true">🎁</div>

    <p class="line rise">Tengo una sorpresa para ti...</p>

    <div class="dots rise" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <noscript>
      <p class="fallback">
        Activa JavaScript o <a href={destination}>pulsa aquí para continuar</a>.
      </p>
    </noscript>
  </main>
</Layout>

<script define:vars={{ destination, delay }}>
  // Redireccion en cliente: los crawlers (WhatsApp, Telegram, X...) no la ejecutan,
  // asi que siguen viendo el HTML con los metadatos Open Graph.
  window.setTimeout(() => {
    // replace() evita que el boton "atras" vuelva a caer en esta pantalla.
    window.location.replace(destination);
  }, delay);
</script>

<style>
  .gift {
    font-size: clamp(3rem, 12vw, 4.5rem);
    line-height: 1;
    animation-delay: 60ms;
  }

  .line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 5.5vw, 2.1rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--fg);
    animation-delay: 180ms;
  }

  .dots {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.35rem;
    animation-delay: 320ms;
  }

  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.1s ease-in-out infinite;
  }

  .dots span:nth-child(2) {
    animation-delay: 0.15s;
    background: var(--accent-2);
  }

  .dots span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .fallback {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
