---
import Layout from '../layouts/Layout.astro';

// ---------------------------------------------------------------
//  ESTA ES LA PAGINA QUE PERSONALIZARAS MAS ADELANTE.
//  Cambia los textos de aqui abajo a tu gusto.
// ---------------------------------------------------------------
const titulo = '🎉 Sorpresa 🎉';
const subtitulo = 'Esto es solo el principio...';
const pie = 'Feliz cumpleaños ❤️';

// Confeti decorativo: posicion/retardo calculados en build.
const confetti = Array.from({ length: 14 }, (_, i) => ({
  left: (i * 7.3 + 3) % 100,
  delay: (i % 7) * 1.1,
  duration: 9 + (i % 5) * 1.6,
  emoji: ['🎈', '✨', '🎊', '💫', '🎁'][i % 5],
}));
---

<Layout title="Sorpresa 🎉" ogTitle="Sorpresa 🎉">
  <div class="aurora"></div>

  <div class="confetti" aria-hidden="true">
    {
      confetti.map((c) => (
        <span
          style={`left:${c.left}%; animation-delay:${c.delay}s; animation-duration:${c.duration}s;`}
        >
          {c.emoji}
        </span>
      ))
    }
  </div>

  <main class="screen">
    <div class="card">
      <h1 class="title rise">{titulo}</h1>
      <p class="subtitle rise">{subtitulo}</p>
      <div class="rule rise" aria-hidden="true"></div>
      <p class="footnote rise">{pie}</p>
    </div>
  </main>
</Layout>

<style>
  .card {
    width: min(100%, 36rem);
    padding: clamp(2rem, 7vw, 3.25rem) clamp(1.25rem, 6vw, 2.75rem);
    border: 1px solid var(--ring);
    border-radius: 24px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.02)
    );
    backdrop-filter: blur(10px);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 9vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    background: linear-gradient(100deg, var(--fg), var(--accent) 55%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation-delay: 120ms;
  }

  .subtitle {
    margin: 1rem 0 0;
    font-size: clamp(1rem, 4vw, 1.2rem);
    color: var(--muted);
    animation-delay: 400ms;
  }

  .rule {
    width: 64px;
    height: 1px;
    margin: 2rem auto;
    background: linear-gradient(90deg, transparent, var(--ring), transparent);
    animation-delay: 620ms;
  }

  .footnote {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(244, 241, 234, 0.75);
    animation-delay: 820ms;
  }

  /* Confeti de fondo */
  .confetti {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .confetti span {
    position: absolute;
    bottom: -10vh;
    font-size: 1.35rem;
    opacity: 0;
    animation-name: float;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  main {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 420px) {
    .confetti span {
      font-size: 1.1rem;
    }
  }
</style>
